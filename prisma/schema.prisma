generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model StoreSetting {
  id           String   @id @default(cuid())
  storeName    String   @default("Nikky's")
  contactEmail String   @default("hello@nikkys.com")
  contactPhone String?
  currency     String   @default("USD")
  timezone     String   @default("UTC")
  updatedAt    DateTime @updatedAt
}

model Product {
  id               String   @id @default(cuid())
  name             String
  brand            String
  price            Float
  originalPrice    Float?
  category         String
  type             String?
  colors           String // Stored as comma-separated hex codes
  sizes            String // Stored as comma-separated values
  images           String // Stored as comma-separated URLs
  isNew            Boolean  @default(false)
  isBestseller     Boolean  @default(false)
  description      String?
  material         String?
  careInstructions String?
  collection       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// NextAuth models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  
  access_token       String?  
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER")
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Order {
  id            String      @id @default(cuid())
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  totalAmount   Float
  status        String      @default("PENDING") // PENDING, PAID, SHIPPED, DELIVERED
  paymentRef    String?     @unique
  shippingName  String
  shippingEmail String
  shippingAddress String
  shippingCity  String
  shippingState String
  shippingZip   String
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  name      String
  price     Float
  quantity  Int
  color     String?
  size      String?
}
